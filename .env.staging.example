# ─────────────────────────────────────────────
# NexMart Staging Environment Variables Template
# Copy this to .env.staging and fill in actual values
# DO NOT commit .env.staging to version control
# ─────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=https://staging.nexmart.ma
NEXT_PUBLIC_APP_NAME=NexMart Staging
NODE_ENV=production

# Database (Neon - use existing production database or staging-specific)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Redis (currently disabled in code, but available for staging)
REDIS_URL=redis://host:port
DISABLE_REDIS=true

# NextAuth
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
NEXTAUTH_URL=https://staging.nexmart.ma
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT Secrets
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Cloudinary (use existing production account or staging-specific)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@nexmart.com

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Admin
ADMIN_EMAIL=admin@nexmart.com
ADMIN_PASSWORD=Admin@123456

# AI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_TIMEOUT_MS=12000
OPENAI_MAX_OUTPUT_TOKENS=700
AI_CHAT_RPM=30
AI_SEARCH_RPM=60
AI_SEARCH_INTENT=true
AI_SEMANTIC_SEARCH=true
ANTHROPIC_API_KEY=

# Tenant
DEFAULT_ORGANIZATION_SLUG=nexmart

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_ENABLE_AI_CHAT=true
NEXT_PUBLIC_ENABLE_AI_SEARCH=true

# CDN (optional)
NEXT_PUBLIC_CDN_URL=https://cdn.nexmart.com

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Email Automation
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=NexMart Maroc <noreply@nexmart.ma>
CRON_SECRET=your-cron-secret-min-32-chars

# AI (Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_VISION_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_TIMEOUT_MS=12000
GEMINI_MAX_OUTPUT_TOKENS=1200

# Google Integrations
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your-ga4-api-secret
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXX
GOOGLE_SEARCH_CONSOLE_VERIFICATION_TOKEN=your-verification-token
GOOGLE_MERCHANT_CENTER_ID=your-merchant-center-id
GOOGLE_MERCHANT_CENTER_API_KEY=your-api-key
GOOGLE_BUSINESS_PROFILE_API_KEY=your-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-api-key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key
GOOGLE_OAUTH_ADMIN_CLIENT_ID=your-admin-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_ADMIN_CLIENT_SECRET=your-admin-client-secret
GOOGLE_OAUTH_CUSTOMER_CLIENT_ID=your-customer-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CUSTOMER_CLIENT_SECRET=your-customer-client-secret
GOOGLE_CREDENTIALS_SECRET=your-32-plus-chars-secret-key
