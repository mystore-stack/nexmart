generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  name          String
  password      String
  avatar        String?
  phone         String?
  role          Role       @default(USER)
  emailVerified Boolean    @default(false)
  verifyToken   String?
  resetToken    String?
  resetExpires  DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  locale        LocaleCode @default(fr)

  orders        Order[]

  @@index([email])
}

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  country   String
  zip       String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  orders    Order[]

  @@index([userId])
}

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  slug           String
  description    String?
  image          String?
  parentId       String?  @db.Uuid
  createdAt      DateTime @default(now())

  products       Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Product {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  name              String
  slug              String
  description       String
  price             Float
  comparePrice      Float?
  cost              Float?
  categoryId        String   @db.Uuid
  images            String[]
  tags              String[]
  sku               String
  stock             Int      @default(0)
  lowStockAt        Int      @default(5)
  weight            Float?
  published         Boolean  @default(false)
  featured          Boolean  @default(false)
  isVisible         Boolean  @default(true)
  displayOrder      Int      @default(0)
  rating            Float    @default(0)
  reviewCount       Int      @default(0)
  soldCount         Int      @default(0)
  source            String?
  externalProductId String?
  externalUrl       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category          Category @relation(fields: [categoryId], references: [id])
  reviews           Review[]
  variants          ProductVariant[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  homepageSectionProducts HomepageSectionProduct[] @relation("ProductSections")

  @@unique([organizationId, sku])
  @@unique([organizationId, slug])
  @@index([categoryId])
  @@index([published])
  @@index([featured])
  @@index([isVisible])
  @@index([displayOrder])
  @@index([organizationId])
  @@index([organizationId, published])
  @@index([organizationId, source])
  @@index([externalProductId])
  @@index([name])
  @@index([sku])
}

model ProductVariant {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  name      String
  value     String
  label     String
  price     Float?
  stock     Int     @default(0)
  sku       String?

  product   Product @relation(fields: [productId], references: [id])
  cartItems CartItem[]

  @@index([productId])
}

model Review {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @db.Uuid
  userId           String   @db.Uuid
  orderId          String?  @db.Uuid
  rating           Int
  title            String?
  body             String
  images           String[]
  helpfulCount     Int      @default(0)
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product          Product @relation(fields: [productId], references: [id])

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([orderId])
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  variantId String?  @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([userId, productId, variantId])
  @@index([userId])
}

model Order {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @db.Uuid
  orderNumber       String
  userId            String        @db.Uuid
  customerId        String?       @db.Uuid
  addressId         String        @db.Uuid
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(UNPAID)
  paymentMethod     PaymentMethod
  subtotal          Float
  discount          Float         @default(0)
  shipping          Float         @default(0)
  tax               Float         @default(0)
  total             Float
  couponId          String?       @db.Uuid
  stripePaymentId   String?       @unique
  idempotencyKey    String?       @unique
  notes             String?
  trackingNumber    String?
  courier           String?
  estimatedDelivery DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  currency          String        @default("MAD")
  deliveryCity      String?

  user     User       @relation(fields: [userId], references: [id])
  address  Address    @relation(fields: [addressId], references: [id])
  coupon   Coupon?    @relation(fields: [couponId], references: [id])
  items    OrderItem[]
  trackingHistory OrderTracking[]

  @@unique([organizationId, orderNumber])
  @@index([userId])
  @@index([status])
  @@index([organizationId])
  @@index([stripePaymentId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@index([createdAt])
}

model OrderTracking {
  id             String      @id @default(uuid()) @db.Uuid
  orderId        String      @db.Uuid
  status         OrderStatus
  trackingNumber String?
  courier        String?
  notes          String?
  createdAt      DateTime    @default(now())

  order          Order       @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  productId String  @db.Uuid
  variantId String? @db.Uuid
  name      String
  image     String
  price     Float
  quantity  Int

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Coupon {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  code           String
  description    String?
  type           String
  value          Float
  minOrder       Float?
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int       @default(0)
  userLimit      Int       @default(1)
  startDate      DateTime  @default(now())
  endDate        DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  orders         Order[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([read])
}

model RecentlyViewed {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  viewedAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  action         String
  userId         String?  @db.Uuid
  organizationId String?  @db.Uuid
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([organizationId])
}

model AuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  sessionId      String?        @db.Uuid
  eventType      AuditEventType
  userId         String?        @db.Uuid
  organizationId String?        @db.Uuid
  orderId        String?        @db.Uuid
  cartSnapshot   Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  fraudScore     Float?         @default(0)
  anomalyFlags   String[]       @default([])
  replayId       String?        @db.Uuid
  createdAt      DateTime       @default(now())

  @@index([sessionId])
  @@index([eventType])
  @@index([userId])
  @@index([organizationId])
  @@index([orderId])
  @@index([createdAt])
  @@index([fraudScore])
  @@index([organizationId, createdAt])
}

model AuditSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String?   @db.Uuid
  organizationId  String    @db.Uuid
  userAgent       String?
  ipAddress       String?
  referrer        String?
  startTime       DateTime  @default(now())
  endTime         DateTime?
  eventCount      Int       @default(0)
  completedSteps  String[]  @default([])
  abandonedAt     DateTime?
  conversionValue Float?
  fraudScore      Float?    @default(0)
  metadata        Json?

  @@index([userId])
  @@index([organizationId])
  @@index([startTime])
  @@index([endTime])
  @@index([fraudScore])
}

model AuditReplay {
  id             String    @id @default(uuid()) @db.Uuid
  sessionId      String    @db.Uuid
  userId         String?   @db.Uuid
  organizationId String    @db.Uuid
  name           String
  description    String?
  events         Json
  cartStates     Json
  replayData     Json?
  createdAt      DateTime  @default(now())
  replayedAt     DateTime?
  replayedBy     String?   @db.Uuid

  @@index([sessionId])
  @@index([userId])
  @@index([organizationId])
  @@index([createdAt])
}

model AuditAlert {
  id             String         @id @default(uuid()) @db.Uuid
  sessionId      String?        @db.Uuid
  userId         String?        @db.Uuid
  organizationId String         @db.Uuid
  alertType      AuditAlertType
  severity       AlertSeverity
  title          String
  description    String?
  metadata       Json?
  resolved       Boolean        @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?        @db.Uuid
  createdAt      DateTime       @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([organizationId])
  @@index([alertType])
  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
}

model CmiPayment {
  id            String           @id @default(uuid()) @db.Uuid
  orderId       String           @unique @db.Uuid
  amount        Float
  currency      String           @default("MAD")
  status        CmiPaymentStatus @default(PENDING)
  cmiOrderId    String
  transactionId String?
  rawResponse   Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  email          String
  name           String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Invoice {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  orderId        String   @unique @db.Uuid
  invoiceNumber  String
  ice            String?
  ifNumber       String?
  subtotalHT     Float
  tvaRate        Float    @default(0.20)
  tvaAmount      Float
  totalTTC       Float
  currency       String   @default("MAD")
  buyerName      String
  buyerAddress   String?
  issuedAt       DateTime @default(now())

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Organization {
  id               String     @id @default(uuid()) @db.Uuid
  name             String
  slug             String     @unique
  logo             String?
  ownerId          String     @db.Uuid
  stripeCustomerId String?    @unique
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  defaultLocale    LocaleCode @default(fr)
  ice              String?
  ifNumber         String?
  legalAddress     String?
  legalName        String?

  @@index([ownerId])
  @@index([slug])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model StripeWebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())
  orderId     String?  @db.Uuid
  metadata    Json?

  @@index([eventId])
  @@index([orderId])
}

model InventoryReservation {
  id             String            @id @default(uuid()) @db.Uuid
  productId      String            @db.Uuid
  variantId      String?           @db.Uuid
  quantity       Int
  status         ReservationStatus @default(RESERVED)
  expiresAt      DateTime
  idempotencyKey String?
  orderId        String?           @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([productId])
  @@index([variantId])
  @@index([status])
  @@index([expiresAt])
  @@index([idempotencyKey])
  @@index([orderId])
}

model NotificationLog {
  id          String              @id @default(uuid()) @db.Uuid
  orderId     String?             @db.Uuid
  userId      String?             @db.Uuid
  type        NotificationType
  channel     NotificationChannel
  recipient   String
  subject     String?
  content     String
  status      NotificationStatus  @default(PENDING)
  error       String?
  sentAt      DateTime?
  deliveredAt DateTime?
  retryCount  Int                 @default(0)
  metadata    Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([type])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  organizationId       String             @unique @db.Uuid
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 PlanTier           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
}

model AiConversation {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String?              @db.Uuid
  organizationId String               @db.Uuid
  status         AiConversationStatus @default(OPEN)
  locale         LocaleCode           @default(fr)
  channel        String               @default("web")
  title          String?
  summary        String?
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId, createdAt])
  @@index([status])
  @@index([userId, createdAt])
}

model AiEvent {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  userId         String?     @db.Uuid
  productId      String?     @db.Uuid
  type           AiEventType
  query          String?
  score          Float?
  metadata       Json?
  createdAt      DateTime    @default(now())

  @@index([organizationId, type, createdAt])
  @@index([productId, createdAt])
  @@index([userId, createdAt])
}

model AiMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  role           AiMessageRole
  content        String
  tokens         Int?
  moderated      Boolean       @default(false)
  blocked        Boolean       @default(false)
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([conversationId, createdAt])
  @@index([role])
}

model AiProductEmbedding {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @unique @db.Uuid
  model          String
  contentHash    String
  embedding      Json
  searchableText String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([contentHash])
}

model HomeBanner {
  id         String    @id @default(uuid()) @db.Uuid
  bannerType String    @default("HERO")
  title      String
  eyebrow    String?
  subtitle   String?
  image      String
  link       String    @default("/products")
  ctaText    String    @default("Découvrir")
  gradient   String?
  order      Int       @default(0)
  active     Boolean   @default(true)
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model HeroSlide {
  id            String    @id @default(uuid()) @db.Uuid
  eyebrow       String?
  title         String
  titleAccent   String?
  subtitle      String?
  cta           String    @default("Explorer la boutique")
  ctaSecondary  String?
  href          String    @default("/products")
  hrefSecondary String?
  badge         String?
  stat          String?
  statLabel     String?
  image         String
  accentColor   String?   @default("#0F766E")
  order         Int       @default(0)
  active        Boolean   @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PromoBannerItem {
  id          String    @id @default(uuid()) @db.Uuid
  iconName    String    @default("Zap")
  eyebrow     String?
  title       String
  subtitle    String?
  cta         String    @default("Profiter")
  href        String    @default("/products")
  gradient    String    @default("from-brand-800 via-brand-700 to-brand-600")
  accentColor String?
  order       Int       @default(0)
  active      Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WhyNexMartValue {
  id          String   @id @default(uuid()) @db.Uuid
  iconName    String   @default("Award")
  title       String
  description String
  stat        String?
  statLabel   String?
  color       String   @default("from-brand-700 to-brand-600")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MobileAppBanner {
  id            String   @id @default(uuid()) @db.Uuid
  title         String   @default("Toute la marketplace premium directement sur votre smartphone.")
  subtitle      String?
  appStoreUrl   String?
  googlePlayUrl String?
  qrCodeImage   String?
  features      Json?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HomePromoCard {
  id            String    @id @default(uuid()) @db.Uuid
  cardKey       String
  title         String
  subtitle      String?
  image         String
  link          String
  ctaText       String
  badgeText     String?
  discountPills Json?
  order         Int       @default(0)
  active        Boolean   @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model FlashDealItem {
  id               String    @id @default(uuid()) @db.Uuid
  productId        String?   @db.Uuid
  name             String
  price            Float
  originalPrice    Float
  discountPercent  Int
  rating           Float     @default(5.0)
  reviewCount      Int       @default(100)
  image            String
  stock            Int       @default(10)
  maxStock         Int       @default(50)
  countdownEndTime DateTime?
  order            Int       @default(0)
  active           Boolean   @default(true)
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model HomeServiceBanner {
  id            String   @id @default(uuid()) @db.Uuid
  bannerKey     String
  title         String
  highlightText String?
  subtitle      String?
  image         String
  link          String
  ctaText       String   @default("En savoir plus")
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SponsoredProduct {
  id        String    @id @default(uuid()) @db.Uuid
  productId String?   @db.Uuid
  name      String
  price     Float
  image     String
  badgeText String    @default("Sponsored")
  order     Int       @default(0)
  active    Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model BestsellerConfig {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String?  @db.Uuid
  rank        Int      @default(1)
  name        String
  price       Float
  rating      Float    @default(5.0)
  reviewCount Int      @default(100)
  image       String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewArrivalConfig {
  id        String   @id @default(uuid()) @db.Uuid
  productId String?  @db.Uuid
  name      String
  price     Float
  badgeText String   @default("Nouveau")
  image     String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MysteryBoxConfig {
  id            String    @id @default(uuid()) @db.Uuid
  title         String
  subtitle      String?
  startingPrice Float     @default(199)
  rating        Float     @default(4.9)
  reviewCount   Int       @default(1000)
  image         String
  link          String    @default("/products?tag=mystery-box")
  ctaText       String    @default("Découvrir")
  active        Boolean   @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model MysteryBox {
  id                 String    @id @default(uuid()) @db.Uuid
  title              String
  description        String?
  image              String
  price              Float
  oldPrice           Float?
  isActive           Boolean   @default(true)
  minGuaranteedValue Float?
  maxProfitPercent   Float?
  order              Int       @default(0)
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model MysteryItem {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  image     String
  value     Float
  rarity    Rarity   @default(COMMON)
  weight    Float    @default(1.0)
  boxId     String   @db.Uuid
  createdAt DateTime @default(now())
}

model MysteryBoxOpen {
  id        String   @id @default(uuid()) @db.Uuid
  boxId     String   @db.Uuid
  itemId    String   @db.Uuid
  userId    String?  @db.Uuid
  itemValue Float
  profit    Float
  openedAt  DateTime @default(now())
}

model BundleConfig {
  id                 String   @id @default(uuid()) @db.Uuid
  title              String   @default("CRÉEZ VOTRE BUNDLE")
  subtitle           String   @default("Choisissez vos produits préférés et économisez jusqu'à 30%")
  maxDiscountPercent Int      @default(30)
  items              Json?
  ctaText            String   @default("Créer mon bundle")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model BrandPartner {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  logo      String?
  fontStyle String?
  iconText  String?
  link      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeFeature {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  subtitle   String
  iconName   String   @default("Truck")
  colorClass String?
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model HomePageSection {
  id             String   @id @default(uuid()) @db.Uuid
  sectionKey     String
  title          String
  subtitle       String?
  description    String?
  bannerImage    String?
  viewAllButton  String?
  destinationUrl String?
  order          Int      @default(0)
  displayOrder   Int      @default(0)
  active         Boolean  @default(true)
  maxProducts    Int      @default(12)
  hideIfEmpty    Boolean  @default(false)
  config         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products       HomepageSectionProduct[] @relation("SectionProducts")
}

model HomepageSectionProduct {
  id          String    @id @default(uuid()) @db.Uuid
  sectionId   String    @db.Uuid
  productId   String    @db.Uuid
  order       Int       @default(0)
  customPrice Float?
  customBadge String?
  active      Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product     Product   @relation("ProductSections", fields: [productId], references: [id])
  section     HomePageSection @relation("SectionProducts", fields: [sectionId], references: [id])

  @@unique([sectionId, productId])
}

model NewsletterConfig {
  id             String   @id @default(uuid()) @db.Uuid
  eyebrow        String   @default("Newsletter exclusive")
  title          String   @default("Les meilleures offres, avant tout le monde.")
  highlightTitle String?  @default("avant tout le monde.")
  description    String   @default("Offres personnalisées, alertes de prix, tendances et promotions exclusives.")
  placeholder    String   @default("Votre adresse email")
  buttonText     String   @default("S'abonner")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FooterConfig {
  id            String   @id @default(uuid()) @db.Uuid
  brandName     String   @default("NexMart")
  tagline       String   @default("Maroc · Premium")
  description   String   @default("La marketplace premium du Maroc — shopping intelligent, artisanat authentique et expérience d'achat d'exception.")
  address       String   @default("Casablanca, Maroc")
  phone         String   @default("+212 5XX-XXXXXX")
  email         String   @default("contact@nexmart.ma")
  copyrightText String   @default("© 2026 NexMart Maroc. Tous droits réservés.")
  linkGroups    Json?
  socials       Json?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

